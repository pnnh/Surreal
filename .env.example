# Poe OpenAI-compatible API
# Get a key: https://poe.com/api/keys
POE_API_KEY=

# Optional: override Poe base URL (default https://api.poe.com/v1)
# POE_BASE_URL=https://api.poe.com/v1

# Local asset root (Git-ignored). Default: ./data
# SURREAL_DATA_DIR=./data

# Max recent user/assistant messages sent per request (default 6)
# SURREAL_CONTEXT_MESSAGE_LIMIT=6

# Text agent model for clarification (default GPT-4o-Mini)
# SURREAL_AGENT_MODEL=GPT-4o-Mini

# --- Later: S3-compatible storage (not required for MVP) ---
# SURREAL_STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
# S3_ENDPOINT=

# 3D Model Generation Provider
# Options:
#   - fal (fal.ai TRELLIS, recommended: ultra-fast, serverless, no queue)
#   - hf_space (Hugging Face Spaces, free ZeroGPU)
#   - custom_http (Self-hosted GPU endpoint)
#   - mock (instant offline test geometry)
THREE_D_PROVIDER=fal

# fal.ai Configuration (used when THREE_D_PROVIDER=fal)
# Get a key: https://fal.ai/dashboard/keys
FAL_KEY=
# Optional: fal 3D endpoint (default: https://fal.run/fal-ai/trellis)
# FAL_3D_ENDPOINT=https://fal.run/fal-ai/trellis

# Hugging Face Configuration (used when THREE_D_PROVIDER=hf_space)
# Get a free token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional: target Space (default: tencent/Hunyuan3D-2.1 or your own duplicated Space)
# HF_SPACE_ID=tencent/Hunyuan3D-2.1

# Custom GPU HTTP Provider (used when THREE_D_PROVIDER=custom_http)
# THREE_D_API_URL=http://127.0.0.1:8000
# THREE_D_API_KEY=